{
  "name": "lexical-review-repo",
  "version": "1.0.0",
  "type": "module",
  "author": "",
  "license": "MIT",
  "private": true,
  "description": "A repo to lexical-review",
  "packageManager": "pnpm@11.28.2",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0",
    "pnpm": ">=11 <12"
  },
  "main": "dist/src/index.js",
  "scripts": {
    "dev": "pnpm nx dev demo",
    "build:demo": "pnpm nx build demo",
    "compatibility": "node scripts/compatibility/runner.mjs run",
    "compatibility:matrix": "node scripts/compatibility/runner.mjs matrix",
    "compatibility:validate": "node scripts/compatibility/runner.mjs validate",
    "compatibility:verify": "node scripts/compatibility/runner.mjs verify",
    "release:dry-run": "node scripts/release/verify.mjs verify",
    "prettier:check": "pnpm exec prettier . --check",
    "preview:demo": "pnpm nx preview demo",
    "lint": "oxlint .",
    "prettier": "pnpm exec prettier . --write",
    "test": "vitest --disable-console-intercept",
    "test:package": "pnpm --filter lexical-review build && node packages/lexical-review/package-contract/verify.mjs",
    "test:e2e": "playwright test",
    "test:e2e:webkit": "playwright test --project=webkit",
    "test:e2e:install": "playwright install --with-deps chromium firefox webkit",
    "test:e2e:install:webkit": "playwright install --with-deps webkit",
    "compatibility:e2e": "node scripts/compatibility/runner.mjs e2e",
    "typecheck:e2e": "tsc --noEmit -p packages/demo/e2e/tsconfig.json"
  },
  "keywords": [
    "lexical",
    "suggestion",
    "review",
    "track changes"
  ],
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "jsdom": "30.1.1",
    "nx": "23.2.1",
    "oxlint": "1.86.0",
    "prettier": "^3.9.9",
    "semver": "^7.8.5",
    "typescript": "7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
