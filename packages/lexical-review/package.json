{
  "name": "lexical-review",
  "version": "3.0.0",
  "description": "Review-mode editing for Lexical with framework-independent extensions",
  "keywords": [
    "lexical",
    "suggestion",
    "review",
    "track changes"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mahendrimd/lexical-review",
    "directory": "packages/lexical-review"
  },
  "scripts": {
    "build": "node build.mjs"
  },
  "license": "MIT",
  "peerDependencies": {
    "@lexical/clipboard": ">=0.47.0 <0.53.0",
    "@lexical/extension": ">=0.47.0 <0.53.0",
    "@lexical/utils": ">=0.47.0 <0.53.0",
    "lexical": ">=0.47.0 <0.53.0"
  },
  "devDependencies": {
    "@lexical/clipboard": "0.52.0",
    "@lexical/extension": "0.52.0",
    "@lexical/utils": "0.52.0",
    "lexical": "0.52.0",
    "rolldown": "^1.2.5"
  }
}
